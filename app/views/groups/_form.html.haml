= semantic_form_for @group do |form|
  = form.inputs do
    != form.input :name
    != form.input :abbreviation
    != form.input :page, collection: Page.all.map { |page| [page.name, page.id] }
    != form.input :website
    != form.input :group_type
  = form.actions do
    != form.action :submit, :label => t("groups.update_group")
